rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isRequestParticipant() {
      return signedIn() && (
        resource.data.get('fromUid', '') == request.auth.uid ||
        resource.data.get('toUid', '') == request.auth.uid
      );
    }

    // Public profile fields live at the root of the canonical user document.
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if isOwner(userId);

      match /followers/{followerId} {
        allow read: if signedIn();
        allow create, update: if isOwner(followerId) && followerId != userId &&
          request.resource.data.uid == followerId;
        allow delete: if isOwner(followerId);
      }

      match /following/{followingId} {
        allow read: if signedIn();
        allow create, update: if isOwner(userId) && followingId != userId &&
          request.resource.data.uid == followingId;
        allow delete: if isOwner(userId);
      }

      match /friends/{friendId} {
        // The recipient accepts a real pending request and consumes it in the
        // same batch that creates both sides of the friendship.
        function acceptsFriendRequest() {
          let requestId = request.resource.data.requestId;
          let invitation = get(/databases/$(database)/documents/friendRequests/$(requestId)).data;
          return invitation.status == 'pending' &&
            request.auth.uid == invitation.toUid &&
            ((invitation.fromUid == userId && invitation.toUid == friendId) ||
             (invitation.fromUid == friendId && invitation.toUid == userId)) &&
            !existsAfter(/databases/$(database)/documents/friendRequests/$(requestId)) &&
            getAfter(/databases/$(database)/documents/users/$(friendId)/friends/$(userId)).data.uid == userId;
        }

        allow read: if isOwner(userId) || isOwner(friendId);
        allow create: if signedIn() && userId != friendId &&
          request.resource.data.uid == friendId && acceptsFriendRequest();
        allow update: if signedIn() && request.resource.data.uid == friendId &&
          (isOwner(userId) || acceptsFriendRequest());
        allow delete: if isOwner(userId) || isOwner(friendId);
      }

      match /movies/{movieId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }
    }

    match /friendRequests/{requestId} {
      allow create: if signedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read, delete: if isRequestParticipant();
      allow update: if false;
    }

    match /listRequests/{requestId} {
      allow create: if signedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == 'pending' &&
        get(/databases/$(database)/documents/lists/$(request.resource.data.listId)).data.ownerId == request.resource.data.toUid;
      allow read, delete: if isRequestParticipant();
      allow update: if false;
    }

    match /lists/{listId} {
      function isCollaborator() {
        return resource.data.get('collaborators', []).hasAny([request.auth.uid]);
      }

      function editsMovies() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['movies', 'updatedAt']) && request.resource.data.movies is list;
      }

      function leavesList() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['collaborators']) &&
          request.resource.data.collaborators ==
            resource.data.collaborators.removeAll([request.auth.uid]);
      }

      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() &&
        request.resource.data.ownerId == resource.data.ownerId && (
          resource.data.ownerId == request.auth.uid ||
          (isCollaborator() && (editsMovies() || leavesList()))
        );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Messaging is frozen, including every nested messages collection.
    match /chats/{document=**} {
      allow read, write: if false;
    }

    // Unmatched collections and subcollections are denied by default.
  }
}
